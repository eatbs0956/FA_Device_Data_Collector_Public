{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "route-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/route/{**remainder}"
        }
      },
      "system-manage-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/systemManage/{**remainder}"
        }
      },
      "admin-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/{**remainder}"
        }
      },
      "jwks-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "device-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/devices/{**remainder}"
        }
      },
      "device-groups-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/device-groups/{**remainder}"
        }
      },
      "edge-nodes-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/edge-nodes/{**remainder}"
        }
      },
      "tags-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/tags/{**remainder}"
        }
      },
      "collection-tasks-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/collection-tasks/{**remainder}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://localhost:60621/"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-api": {
            "Address": "http://localhost:60623/"
          }
        }
      }
    }
  }
}
