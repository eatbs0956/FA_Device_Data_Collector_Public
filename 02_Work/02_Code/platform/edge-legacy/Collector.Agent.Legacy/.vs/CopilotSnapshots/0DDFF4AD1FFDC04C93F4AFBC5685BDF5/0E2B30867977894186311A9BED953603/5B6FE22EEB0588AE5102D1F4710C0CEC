        private async Task ConnectSignalR()
        {
            try
            {
                AppendLog("正在连接SignalR...", LogLevel.Info);
                _signalRService.OnConfigChanged += SignalRService_OnConfigChanged;
                _signalRService.OnConnectionStateChanged += SignalRService_OnConnectionStateChanged;

                await _signalRService.ConnectAsync(
                    _appService.GatewayUrl,
                    _appService.CurrentNodeId,
                    _appService.AccessToken
                );

                _connectionStatusLabel.Text = "连接状态: 已连接";
                _connectionStatusLabel.ForeColor = Color.Green;
                AppendLog("SignalR连接成功", LogLevel.Info);
            }
            catch (Exception ex)
            {
                Logger.Error(ex, "SignalR连接失败");
                _connectionStatusLabel.Text = "连接状态: 连接失败";
                _connectionStatusLabel.ForeColor = Color.Red;
                AppendLog($"SignalR连接失败: {ex.Message}", LogLevel.Error);
            }
        }

        private void SignalRService_OnConfigChanged(object sender, ConfigChangedEventArgs e)
        {
            this.BeginInvoke(new Action(async () =>
            {
                AppendLog($"收到配置变更通知: {e.ChangeType}", LogLevel.Warn);
                switch (e.ChangeType)
                {
                    case "ConfigUpdated":
                        await RefreshConfig();
                        break;
                    case "RestartRequested":
                        await RestartCollection();
                        break;
                    case "EmergencyStop":
                        await StopCollection();
                        MessageBox.Show("收到紧急停止命令！", "警告", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        break;
                }
            }));
        }

        private void SignalRService_OnConnectionStateChanged(object sender, bool connected)
        {
            this.BeginInvoke(new Action(() =>
            {
                if (connected)
                {
                    _connectionStatusLabel.Text = "连接状态: 已连接";
                    _connectionStatusLabel.ForeColor = Color.Green;
                }
                else
                {
                    _connectionStatusLabel.Text = "连接状态: 已断开";
                    _connectionStatusLabel.ForeColor = Color.Red;
                }
            }));
        }

        private async Task RefreshConfig()
        {
            try
            {
                AppendLog("正在刷新配置...", LogLevel.Info);
                var config = await _appService.GetNodeConfigAsync();
                if (config != null)
                {
                    _deviceCountValueLabel.Text = config.Devices?.Count.ToString() ?? "0";
                    _taskCountValueLabel.Text = config.Tasks?.Count.ToString() ?? "0";
                    AppendLog($"配置刷新成功: {config.Devices?.Count ?? 0} 个设备, {config.Tasks?.Count ?? 0} 个任务", LogLevel.Info);
                }
            }
            catch (Exception ex)
            {
                Logger.Error(ex, "刷新配置失败");
                AppendLog($"刷新配置失败: {ex.Message}", LogLevel.Error);
            }
        }

        private async Task StartCollection()
        {
            try
            {
                _startButton.Enabled = false;
                AppendLog("正在启动采集引擎...", LogLevel.Info);

                // TODO: 这里应该初始化采集引擎
                // 目前只是设置状态标志
