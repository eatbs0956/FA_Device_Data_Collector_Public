                AppendLog(string.Format("停止采集失败: {0}", ex.Message), LogLevel.Error);
                _stopButton.Enabled = true;
            }
        }

        private async Task RestartCollection()
        {
            await StopCollection();
            await Task.Delay(1000);
            await StartCollection();
        }

