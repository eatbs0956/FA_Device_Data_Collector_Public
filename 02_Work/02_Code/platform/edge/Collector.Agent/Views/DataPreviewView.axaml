<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collector.Agent.ViewModels"
             xmlns:l="using:Collector.Agent.Localization"
             x:Class="Collector.Agent.Views.DataPreviewView"
             x:DataType="vm:DataPreviewViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 标题 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">        
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <ToggleButton IsChecked="{Binding IsAutoRefresh}" 
                              Content="{l:Localize DataPreview.AutoRefresh}"
                              Padding="12,8"/>
                <Button Content="{l:Localize DataPreview.Clear, Prefix='🗑 '}" 
                        Classes="secondary"
                        Command="{Binding ClearDataCommand}"/>
            </StackPanel>
            <TextBlock Text="{l:Localize DataPreview.Title}" Classes="pageTitle"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 数据列表 -->
        <Border Grid.Row="1" Classes="card">
            <Border CornerRadius="6" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding RecentDataPoints}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          RowHeight="32"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Localize Header.Time}" Binding="{Binding FormattedTime}" Width="120"/>
                        <DataGridTextColumn Header="{l:Localize Header.Device}" Binding="{Binding DeviceName}" Width="140"/>
                        <DataGridTextColumn Header="{l:Localize Header.TagName}" Binding="{Binding TagName}" Width="160"/>
                        <DataGridTextColumn Header="{l:Localize Header.RawValue}" Binding="{Binding RawValue}" Width="200"/>
                        <DataGridTextColumn Header="{l:Localize Header.ConvertedValue}" Binding="{Binding Value}" Width="200"/>
                        <DataGridTextColumn Header="{l:Localize Header.Unit}" Binding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="{l:Localize Header.Quality}" Binding="{Binding Quality}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </Grid>
</UserControl>
