<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collector.Agent.ViewModels"
             xmlns:l="using:Collector.Agent.Localization"
             x:Class="Collector.Agent.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{l:Localize Diagnostics.Title}" Classes="pageTitle" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            <!-- 左侧：设备列表 + 操作按钮 -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,16,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 标题 + 刷新 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="🔄"
                                Classes="secondary"
                                Command="{Binding RefreshDevicesCommand}"
                                Padding="8,4"
                                FontSize="12"
                                ToolTip.Tip="{l:Localize Diagnostics.RefreshTooltip}"/>
                        <TextBlock Text="{l:Localize Diagnostics.SelectDevice}" Classes="cardTitle" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 设备列表 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             MinHeight="80">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 操作按钮组 -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="6">
                        <TextBlock Text="{l:Localize Diagnostics.SelectedDeviceOps}" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,2"/>
                        <Button Content="{l:Localize Diagnostics.TestConnection, Prefix='🔗 '}"
                                Classes="primary"
                                Command="{Binding TestConnectionCommand}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{l:Localize Diagnostics.ReadAllTags, Prefix='📖 '}"
                                Classes="secondary"
                                Command="{Binding ReadAllTagsCommand}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                        <Separator Margin="0,4"/>

                        <TextBlock Text="{l:Localize Diagnostics.AllDeviceOps}" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,2"/>
                        <Button Content="{l:Localize Diagnostics.TestAllConnections, Prefix='🔗 '}"
                                Classes="secondary"
                                Command="{Binding TestAllConnectionsCommand}"
                                HorizontalAlignment="Stretch"/>
                        <Button Content="{l:Localize Diagnostics.ReadAllDevicesTags, Prefix='📖 '}"
                                Classes="secondary"
                                Command="{Binding ReadAllDevicesTagsCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：读取结果 DataGrid -->
            <Border Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{l:Localize Diagnostics.Results}" Classes="cardTitle" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <DataGrid ItemsSource="{Binding ReadResults}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  RowHeight="32"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:Localize Header.Device}"
                                                    Binding="{Binding DeviceName}"
                                                    Width="250"/>
                                <DataGridTextColumn Header="{l:Localize Header.TagName}"
                                                    Binding="{Binding TagName}"
                                                    Width="250"/>
                                <DataGridTextColumn Header="{l:Localize Header.RawValue}"
                                                    Binding="{Binding RawValueText}"
                                                    Width="180"/>
                                <DataGridTextColumn Header="{l:Localize Header.ConvertedValue}"
                                                    Binding="{Binding ValueText}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="{l:Localize Header.Quality}"
                                                    Binding="{Binding Quality}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="{l:Localize Header.Success}"
                                                    Binding="{Binding SuccessText}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="{l:Localize Header.Timestamp}"
                                                    Binding="{Binding Timestamp}"
                                                    Width="180"/>
                                <DataGridTextColumn Header="{l:Localize Header.ErrorInfo}"
                                                    Binding="{Binding ErrorMessage}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Classes="card"
                Margin="0,16,0,0"
                IsVisible="{Binding ReadResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding ReadResult}"
                           FontSize="13"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding IsBusy}"
                            Margin="16,0,0,0">
                    <TextBlock Text="{Binding BusyMessage}"
                               Foreground="#2563eb"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
