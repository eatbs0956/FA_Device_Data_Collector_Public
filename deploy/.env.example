# Copy to .env and fill in real values.
# Never commit .env.

# ---- Image ----
IMAGE_REGISTRY=ghcr.io/eatbs0956
# 注意：docker/metadata-action 的 semver pattern 会剥离 v 前缀
# v0.1.0 (git tag) → 镜像 tag 为 0.1.0 / 0.1 / latest
# 自 v0.2.0 起同时推 v 前缀 raw tag，两种写法都能用
IMAGE_TAG=0.1.0

# ---- Public URLs ----
# 浏览器可访问的网关地址（与反向代理/域名一致）
PUBLIC_API_BASE=http://localhost:18020
# 其它服务 base URL，可选（JSON5），默认 {}
PUBLIC_OTHER_API_BASE={}

# ---- Port bindings ----
GATEWAY_PORT=18020
WEB_PORT=80

# ---- PostgreSQL ----
PG_DATABASE=devdcp
PG_USER=devdcp
PG_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD

# ---- RabbitMQ ----
RABBITMQ_USER=devdcp
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

# ---- InfluxDB ----
INFLUX_USER=devdcp
INFLUX_PASSWORD=CHANGE_ME_STRONG_INFLUX_PASSWORD
INFLUX_ORG=devorg
INFLUX_BUCKET=collected
INFLUX_TOKEN=CHANGE_ME_STRONG_INFLUX_TOKEN
INFLUX_RETENTION=90d

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ---- JWT ----
# PKCS#8/PKCS#1 PEM RSA 私钥的宿主机路径；生产 compose 以只读 secret 挂载。
# 示例生成命令: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out ./secrets/jwt-private.pem
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
# 可选。留空时根据公钥 SHA-256 指纹生成稳定 kid；轮换密钥时可显式指定版本化 kid。
JWT_KEY_ID=

# ---- Business ----
PASSWORD_EXPIRE_DAYS=90
